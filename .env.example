# Copy this file to .env.local and fill in real values.
# See README.md#environment-variables for what each variable is used for.

# Clerk (auth) — standard Clerk variable names, read internally by @clerk/nextjs
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# PostgreSQL
PGHOST=
PGDATABASE=
PGUSER=
PGPASSWORD=

# AWS (S3 uploads + CloudFront delivery)
AWS_REGION=
AWS_BUCKET_NAME=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_DOMAIN_OPTIMIZED=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (email)
RESEND_API_KEY=

# TalkJS (messaging)
NEXT_PUBLIC_TALK_DEV=
NEXT_PUBLIC_TALK_DEV_ID=
NEXT_PUBLIC_TALK_PROD_ID=

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Misc
# Set to "true" to bypass photographer visibility checks on the discover page (testing only)
bypass_vis=
